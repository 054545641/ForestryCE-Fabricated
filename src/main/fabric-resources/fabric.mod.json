{
  "schemaVersion": 1,
  "id": "forestry",
  "version": "${version}",
  "name": "Forestry CE — Fabric",
  "description": "Forestry for Fabric 26.2. Native gameplay, rendering, world generation and optional JEI/Jade adapters.",
  "environment": "*",
  "accessWidener": "forestry.accesswidener",
  "mixins": [
    "forestry.mixins.json"
  ],
  "license": "LGPL-3.0-only",
  "entrypoints": {
    "jade": ["forestry.core.platform.compat.jade.ForestryJadePlugin"],
    "jei_mod_plugin": ["forestry.apiculture.compat.ApicultureJeiPlugin","forestry.arboriculture.compat.ArboricultureJeiPlugin","forestry.core.content.backpacks.compat.StorageJeiPlugin","forestry.core.content.machines.recipes.jei.FactoryJeiPlugin","forestry.core.content.worktable.compat.WorktableJeiPlugin","forestry.core.platform.client.compat.CoreJeiPlugin"],
    "forestry:module": [
      "forestry.core.features.CoreFabricModule"
    ],
    "main": [
      "forestry.Forestry"
    ],
    "client": [
      "forestry.core.platform.client.ForestryFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-api": ">=0.161.0+26.2",
    "team_reborn_energy": "^5.0.0"
  }
}
