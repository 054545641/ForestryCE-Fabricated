{
  "schemaVersion": 1,
  "id": "forestrymail",
  "version": "${version}",
  "name": "Forestry Mail — Fabric",
  "description": "Optional mail, stamps and trading stations for Forestry Fabric 26.2.",
  "environment": "*",
  "license": "LGPL-3.0-only",
  "entrypoints": {
    "jei_mod_plugin": ["forestry.mail.compat.MailJeiPlugin"],
